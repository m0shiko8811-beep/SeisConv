node_modules/
dist/
renderer/dist/
release/
*.log
.DS_Store

# Per-machine QA input paths (real local data; never published)
qa/local-paths.json

# QA screenshot output (regenerated by the harness; never committed)
qa/shots/

# Pre-existing legacy files kept beside the repo, not part of it
Old/
seisconv_v5.11_22.html

# Generated manual output (HTML + PDF); regenerate with `npm run manual`
docs/manual/out/

# Manual screenshots: regenerated by `npm run manual:shots` (33 PNGs, ~8 MB a run).
# The PNGs are NOT committed - the repo pack is ~15 MB, so committing them would more
# than double it immediately and grow it again on every release, since git keeps every
# version of a binary forever. The callout KEYS beside them (*.json) ARE committed: they
# are a few kB, they are what the manual prose references, and a diff of them shows when
# a control moved. Regenerate the images before rendering the PDF.
docs/manual/img/*.png
