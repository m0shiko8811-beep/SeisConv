    given-names: "Moshe"
version: "0.6.0"
date-released: "2026-07-06"
license: LicenseRef-Proprietary
repository-code: "https://github.com/m0shiko8811-beep/SeisConv"
keywords:
  - seismic
  - segy
  - segd
  - seismic-unix
  - sps
  - geophysics
  - seismic-processing
  - exploration-geophysics
  - vibroseis
  - electron
